# Copy to .env.local and fill in. .env.local is gitignored.
# Project settings -> API in the Supabase dashboard.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: the Supabase service-role key and the OpenRouter API key must NEVER be
# VITE_* prefixed, and must never live in this app at all. Anything Vite bundles
# is readable by the user, so a key here is a public key.
#
# Those belong in the Supabase Edge Function's secrets, set with:
#   supabase secrets set OPENROUTER_API_KEY=sk-or-...
